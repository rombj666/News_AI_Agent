{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personalized-news-ai-agent",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2026-09-17",

  "vars": {
    "TELEGRAM_AI_ENABLED": "YES",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "MAX_INPUT_TOKENS": "12000",
    "MAX_OUTPUT_TOKENS": "2000",

    "RSS_SOURCES_JSON": "[{\"id\":\"bbc-technology\",\"name\":\"BBC Technology\",\"url\":\"https://feeds.bbci.co.uk/news/technology/rss.xml\",\"category\":\"technology\",\"enabled\":true}]",

    "PRODUCTION_SCHEDULE_ENABLED": "NO",
    "SCHEDULE_NOTIFY_EMPTY": "NO",
    "SCHEDULE_BRAVE_QUERY": "",

    "BRAVE_COST_PER_REQUEST_NANODOLLARS": "5000000",
    "BRAVE_PRICING_VERSION": "brave-search-2026-09",
    "RETRIEVAL_MONTHLY_BUDGET_NANODOLLARS": "1000000000"
  },

  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
