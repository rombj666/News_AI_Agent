# Normal tests/demo remain offline. Only the explicit live retrieval command reads this file.
APP_MODE=offline
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
BRAVE_API_KEY=
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
# Provisional development limits. Live accounting reservations come before live calls.
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=2000
DAILY_SEARCH_LIMIT=10
MONTHLY_BUDGET_USD=10.00

# Milestone 2: npm run test:live:retrieval ONLY. Never enabled by test/demo.
# Enable the selected feed in config/rss-sources.json before opting in.
RUN_LIVE_RETRIEVAL=NO
LIVE_RSS_SOURCE_ID=bbc-technology
LIVE_BRAVE_QUERY=
# Gross per-request estimate from YOUR plan (1 USD = 1,000,000,000 nanodollars).
BRAVE_COST_PER_REQUEST_NANODOLLARS=
BRAVE_PRICING_VERSION=
RETRIEVAL_MONTHLY_BUDGET_NANODOLLARS=


# Optional provider isolation for explicit retrieval tests: both | rss | brave.
LIVE_RETRIEVAL_PROVIDER=both
# Separate opt-in: npm run test:live:openai. Requires an existing local user/profile.
RUN_LIVE_OPENAI=NO
LIVE_OPENAI_USER_ID=
OPENAI_RANKING_MONTHLY_BUDGET_NANODOLLARS=
