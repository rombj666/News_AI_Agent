# Normal tests/demo remain offline. Only explicit live commands read this file.
APP_MODE=offline
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
BRAVE_API_KEY=
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
# Provisional development limits. Live accounting reservations come before live calls.
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=2000
DAILY_SEARCH_LIMIT=10
MONTHLY_BUDGET_USD=10.00

# Milestone 2: npm run test:live:retrieval ONLY. Never enabled by test/demo.
# Enable the selected feed in config/rss-sources.json before opting in.
RUN_LIVE_RETRIEVAL=NO
LIVE_RSS_SOURCE_ID=bbc-technology
LIVE_BRAVE_QUERY=
# Gross per-request estimate from YOUR plan (1 USD = 1,000,000,000 nanodollars).
BRAVE_COST_PER_REQUEST_NANODOLLARS=
BRAVE_PRICING_VERSION=
RETRIEVAL_MONTHLY_BUDGET_NANODOLLARS=


# Optional provider isolation for explicit retrieval tests: both | rss | brave.
LIVE_RETRIEVAL_PROVIDER=both
# Separate opt-in: npm run test:live:openai. Requires an existing local user/profile.
RUN_LIVE_OPENAI=NO
LIVE_OPENAI_USER_ID=
OPENAI_RANKING_MONTHLY_BUDGET_NANODOLLARS=

# Milestone 5: separate opt-in for ONE small NORMAL digest from existing rankings.
RUN_LIVE_DIGEST=NO
OPENAI_DIGEST_MONTHLY_BUDGET_NANODOLLARS=
# Explicit regeneration creates a new billable revision; leave NO normally.
LIVE_DIGEST_FORCE=NO

# Milestone 6: local polling only; TELEGRAM_WEBHOOK_SECRET is not needed.
# First run telegram:whoami and put your numeric ID in TELEGRAM_ALLOWED_USER_IDS.
# Comma-separated IDs are supported. No username-based authorization.
RUN_LIVE_TELEGRAM=NO
# Only needed when the allowlist has multiple users and selecting the test recipient.
LIVE_TELEGRAM_USER_ID=
# Commands, saved digest delivery and feedback work without AI enabled.
TELEGRAM_AI_ENABLED=NO
# Required only for TELEGRAM_AI_ENABLED=YES; covers monthly conversation AI usage.
OPENAI_TELEGRAM_MONTHLY_BUDGET_NANODOLLARS=

# Milestone 7: explicit opt-in for scheduler and one-run live commands.
# Existing ranking/digest budgets above are required. No deployment involved.
RUN_LIVE_SCHEDULED_PIPELINE=NO
SCHEDULER_INTERVAL_SECONDS=30
SCHEDULE_NOTIFY_EMPTY=NO
# Optional shared public query; blank means RSS only. Existing Brave limits apply.
SCHEDULE_BRAVE_QUERY=
